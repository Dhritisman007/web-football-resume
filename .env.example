# Copy to .env.local and fill in. All values are optional; the site shows
# clearly marked placeholders until they are set.

# Canonical URL used for SEO metadata, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://example.com

# GitHub username for CURRENT FORM. Public data only; no token is used.
# The username is set in data/profile.ts, so this variable is optional.
NEXT_PUBLIC_GITHUB_USERNAME=
